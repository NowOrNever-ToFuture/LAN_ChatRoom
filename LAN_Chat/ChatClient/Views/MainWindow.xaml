<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="LAN Chat Room" Height="700" Width="980" MinHeight="580" MinWidth="820"
        Background="#FFEAF0F4" FontFamily="Segoe UI Emoji">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF0F766E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF0F766E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFF7ED"/>
            <Setter Property="BorderBrush" Value="#FFF59E0B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFE0F2FE" Offset="0"/>
                <GradientStop Color="#FFF8FAFC" Offset="0.45"/>
                <GradientStop Color="#FFCCFBF1" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Margin="22" Padding="18" CornerRadius="24" Background="#F7FFFFFF" BorderBrush="#CCE2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="58" Height="58" CornerRadius="18" Background="#FF102A43" Margin="0,0,14,0">
                        <Image Source="{StaticResource AppIcon}" Width="42" Height="42"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Chat Room" FontSize="26" FontWeight="Bold" Foreground="#FF102A43"/>
                        <TextBlock Text="Chat nội bộ " FontSize="13" Foreground="#FF62748A"/>
                    </StackPanel>

                    <Border Grid.Column="2" Padding="12,7" CornerRadius="16" Background="#FFFFF1F2" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTextBlock" Text="Offline" Foreground="#FFBE123C" FontWeight="Bold"/>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Padding="14" CornerRadius="18" Background="#FFFFFFFF" BorderBrush="#FFE2E8F0" BorderThickness="1" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Server IP" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#FF334155"/>
                        <TextBox x:Name="ServerIpTextBox" Grid.Column="1" Height="36" Padding="10,0" VerticalContentAlignment="Center" Text="127.0.0.1"/>

                        <TextBlock Grid.Column="3" Text="Username" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#FF334155"/>
                        <TextBox x:Name="UsernameTextBox" Grid.Column="4" Height="36" Padding="10,0" VerticalContentAlignment="Center"/>

                        <Button x:Name="ConnectButton" Grid.Column="6" Height="36" MinWidth="110" Content="Connect" Style="{StaticResource PrimaryButtonStyle}" Click="ConnectButton_Click"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Padding="12" CornerRadius="20" Background="#FFFFFFFF" BorderBrush="#FFE2E8F0" BorderThickness="1">
                    <ListBox x:Name="MessagesListBox" ItemsSource="{Binding Messages}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Margin="0,4" CornerRadius="14" Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1">
                                    <TextBlock TextWrapping="Wrap" FontSize="14">
                                        <Run Text="[" Foreground="#FF94A3B8"/>
                                        <Run Text="{Binding TimestampText, Mode=OneWay}" Foreground="#FF94A3B8"/>
                                        <Run Text="] " Foreground="#FF94A3B8"/>
                                        <Run Text="{Binding SenderDisplayName, Mode=OneWay}" FontWeight="Bold" Foreground="#FF0F766E"/>
                                        <Run Text=": "/>
                                        <Run Text="{Binding Content}"/>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Button x:Name="EmojiButton" Width="46" Height="42" Content="😀" Style="{StaticResource IconButtonStyle}" Click="EmojiButton_Click"/>
                        <Popup x:Name="EmojiPopup" PlacementTarget="{Binding ElementName=EmojiButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                            <Border Padding="12" CornerRadius="18" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="1">
                                <ItemsControl x:Name="EmojiItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Width="280"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Width="38" Height="38" FontSize="20" Margin="3" Click="EmojiItem_Click"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>

                    <TextBox x:Name="MessageInputTextBox" Grid.Column="2" Height="42" Padding="12,0" VerticalContentAlignment="Center" FontSize="14" KeyDown="MessageInputTextBox_KeyDown"/>
                    <Button x:Name="SendButton" Grid.Column="4" Height="42" MinWidth="112" Content="Send" Style="{StaticResource PrimaryButtonStyle}" Click="SendButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
