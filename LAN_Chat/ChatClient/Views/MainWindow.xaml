<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="LAN Chat Room" Height="620" Width="920" MinHeight="520" MinWidth="760"
        Background="#FFF2F5F7">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12" CornerRadius="10" BorderThickness="1" BorderBrush="#FFD4DCE3" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Server IP" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <TextBox x:Name="ServerIpTextBox" Grid.Column="1" Height="32" Padding="8,0" VerticalContentAlignment="Center" Text="127.0.0.1"/>

                <TextBlock Grid.Column="3" Text="Username" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <TextBox x:Name="UsernameTextBox" Grid.Column="4" Height="32" Padding="8,0" VerticalContentAlignment="Center"/>

                <Button x:Name="ConnectButton" Grid.Column="6" Height="32" MinWidth="104" Content="Connect" Click="ConnectButton_Click"/>
                <TextBlock x:Name="StatusTextBlock" Grid.Column="8" Text="Offline" VerticalAlignment="Center" Foreground="#FF8A1F1F" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,14" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="#FFD4DCE3" Background="White">
            <ListBox x:Name="MessagesListBox" ItemsSource="{Binding Messages}" BorderThickness="0" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8" Margin="0,3" CornerRadius="8" Background="#FFF8FAFC">
                            <TextBlock TextWrapping="Wrap" FontSize="14">
                                <Run Text="[" Foreground="#FF7A8694"/>
                                <Run Text="{Binding TimestampText}" Foreground="#FF7A8694"/>
                                <Run Text="] " Foreground="#FF7A8694"/>
                                <Run Text="{Binding SenderDisplayName}" FontWeight="Bold"/>
                                <Run Text=": "/>
                                <Run Text="{Binding Content}"/>
                            </TextBlock>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="MessageInputTextBox" Grid.Column="0" Height="38" Padding="10,0" VerticalContentAlignment="Center" KeyDown="MessageInputTextBox_KeyDown"/>
            <Button x:Name="SendButton" Grid.Column="2" Height="38" MinWidth="100" Content="Send" Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>
